# ============================================================
# Meridian — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it contains real secrets.
# ============================================================

# --- Database (Neon PostgreSQL) ---
# Get from: https://console.neon.tech → your project → Connect
DATABASE_URL=""
DIRECT_URL=""

# --- Clerk (Authentication) ---
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/account"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/account"

# --- Stripe (Payments — test mode) ---
# Get from: https://dashboard.stripe.com → Developers → API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
# Webhook secret (dev): printed by `stripe listen`
# Webhook secret (prod): Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=""

# --- Cloudinary (Image uploads) ---
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Resend (Transactional email) ---
# Get from: https://resend.com → API Keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Admin promotion (comma-separated emails) ---
# Any user signing up with one of these emails is auto-promoted to ADMIN
ADMIN_EMAILS=""